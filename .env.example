DISCORD_TOKEN=your_discord_user_token_here
GEMINI_API_KEY=your_gemini_api_key_here
REDIS_URL=redis://...  # Railway Redis addon provides this

# NotebookLM authentication (for worker.py)
# Run: .venv310/bin/notebooklm login
# Then: cat ~/.notebooklm/profiles/default/storage_state.json
# Copy the entire JSON output as the value below
NOTEBOOKLM_AUTH_JSON={"cookies":[...]}
